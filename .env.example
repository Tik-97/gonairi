# Neon/Supabase Postgres. Pooled connection is used by the app at runtime;
# the direct (non-pooled) connection is used only by `prisma migrate`.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-generated-secret"

# Vercel Blob store token, used for tour photo uploads.
# Create a Blob store in your Vercel project (Storage tab) — the token is
# generated for you there. Locally you can also run `vercel env pull`.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# Public marketplace kill-switch (proxy.ts). Unset or anything other than
# "true" keeps it closed — only the back-office is live. Set to "true" to
# open the marketplace routes (/, /tours, /agencies, /book, /bookings).
MARKETPLACE_ENABLED="false"

# Shared secret for POST /api/revalidate-sitemap (on-demand sitemap refresh,
# e.g. from a server cron job). Generate the same way as AUTH_SECRET.
# Leave unset to disable the endpoint entirely (it always returns 401).
REVALIDATE_SECRET="replace-with-a-generated-secret"

# Development bootstrap account created by `npx prisma db seed` when no
# Platform Admin exists. Always override these values outside local development.
SEED_ADMIN_EMAIL="admin@test.com"
SEED_ADMIN_PASSWORD="password"
SEED_ADMIN_NAME="Platform Admin"

# --- Zoho Mail HTTPS API (Try Demo lead notifications) ---
# Generate OAuth credentials for the existing mailbox with the
# ZohoMail.messages.CREATE scope and offline access. The app exchanges the
# refresh token for short-lived access tokens automatically.
ZOHO_CLIENT_ID="replace-with-zoho-oauth-client-id"
ZOHO_CLIENT_SECRET="replace-with-zoho-oauth-client-secret"
ZOHO_REFRESH_TOKEN="replace-with-zoho-oauth-refresh-token"
ZOHO_ACCOUNT_ID="replace-with-zoho-mail-account-id"
ZOHO_FROM_EMAIL="hello@gonairi.com"

# These defaults select Zoho's EU data center. Change both for a mailbox in a
# different Zoho data center.
ZOHO_ACCOUNTS_URL="https://accounts.zoho.eu"
ZOHO_MAIL_API_URL="https://mail.zoho.eu/api"

# Inbox that receives Try Demo lead notifications.
TRY_DEMO_LEAD_EMAIL_TO="hello@gonairi.com"

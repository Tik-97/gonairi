// Prisma schema for ToursOrganizer — multi-tenant tour agency SaaS + booking marketplace.
// See C:\Users\Tigran\.claude\plans\cuddly-inventing-stonebraker.md for the architecture this implements.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  OPERATOR
  DRIVER
  GUIDE
  /// Can be assigned to a departure's vehicle as either the driver or the
  /// guide (or both, on the same DepartureVehicle row) — for tours (e.g.
  /// jeeping tours) where one person routinely does both jobs.
  DRIVER_GUIDE
}

enum AttendanceStatus {
  WORKED
  ABSENT
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum DepartureStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum BookingSource {
  MANUAL
  ONLINE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD_ONLINE
  OTHER
}

enum PaymentRecordStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum TravelerPriceType {
  FULL
  HALF
  FREE
}

/// A platform-level operator account — not tied to any tenant Organization.
/// Logs in through the shared /login page and manages the whole platform.
model PlatformAdmin {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A single permission grant for a UserRole, platform-wide (not tenant-scoped).
/// This is the editable source of truth behind lib/auth/permissions.ts — the
/// Super Admin dashboard at /admin/roles adds/removes rows here instead of a
/// permission matrix being hardcoded in application code.
model RolePermission {
  id         String   @id @default(cuid())
  role       UserRole
  permission String
  createdAt  DateTime @default(now())

  @@unique([role, permission])
  @@index([role])
}

/// A tenant: one tour agency using the platform.
model Organization {
  id           String  @id @default(cuid())
  ownerId      String
  owner        User    @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  name         String
  slug         String  @unique
  description  String?
  logoUrl      String?
  contactEmail String?
  contactPhone String?
  address      String?
  language     String  @default("hy")
  currency     String  @default("AMD")
  timezone     String  @default("Asia/Yerevan")
  isPublished  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]             @relation("OrganizationMembers")
  customers         Customer[]
  tours             Tour[]
  departures        Departure[]
  departureVehicles DepartureVehicle[]
  vehicles          Vehicle[]
  bookings          Booking[]
  payments          Payment[]
  bookingTravelers  BookingTraveler[]
  attendanceRecords Attendance[]

  @@index([ownerId])
}

/// Agency account — owner/operator, plus drivers and guides who can be
/// assigned to departures. Assigned roles govern both permissions and, for
/// DRIVER/GUIDE/DRIVER_GUIDE, eligibility to show up in departure vehicle
/// assignment pickers (DRIVER_GUIDE is eligible for both the driver and
/// guide slot on a DepartureVehicle row).
model User {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation("OrganizationMembers", fields: [organizationId], references: [id], onDelete: SetNull)

  email        String     @unique
  passwordHash String
  name         String
  phone        String?
  roles        UserRole[] @default([OPERATOR])
  status       UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBookings         Booking[]          @relation("BookingCreatedByUser")
  guidedDepartureVehicles DepartureVehicle[] @relation("DepartureVehicleGuide")
  drivenDepartureVehicles DepartureVehicle[] @relation("DepartureVehicleDriver")
  attendanceRecords       Attendance[]
  ownedOrganizations      Organization[]     @relation("OrganizationOwner")

  @@index([organizationId])
  @@index([roles], type: Gin)
}

/// A day marked as worked or absent for a staff member — the basic HR/attendance ledger.
model Attendance {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  date   DateTime         @db.Date
  status AttendanceStatus
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([organizationId, date])
}

/// CRM contact — independent of User; created manually by staff or from a guest booking.
model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  fullName    String
  email       String?
  phone       String?
  nationality String?
  notes       String?
  source      BookingSource @default(MANUAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@index([organizationId])
  @@index([organizationId, email])
}

/// A tour product template (not itself bookable — Departures are).
model Tour {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title            String
  slug             String
  description      String?
  category         String?
  regions          String[]
  durationDays     Int      @default(1)
  languagesOffered String[]
  images           String[]
  itinerary        Json?
  included         String?
  excluded         String?
  basePrice        Decimal  @db.Decimal(10, 2)
  currency         String   @default("AMD")
  isPublished      Boolean  @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  departures Departure[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, isPublished])
  @@index([organizationId, deletedAt])
}

/// A scheduled, dated, bookable instance of a Tour.
model Departure {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tourId         String
  tour           Tour         @relation(fields: [tourId], references: [id], onDelete: Cascade)

  date          DateTime
  /// Estimated return time — when the assigned vehicle is expected back and
  /// free to be booked on another departure. Null means unknown; conflict
  /// checks then assume the vehicle is tied up for a full 24h from `date`.
  returnAt      DateTime?
  capacity      Int
  bookedCount   Int             @default(0)
  priceOverride Decimal?        @db.Decimal(10, 2)
  status        DepartureStatus @default(SCHEDULED)
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
  vehicles DepartureVehicle[]

  @@index([organizationId, tourId, date])
  @@index([organizationId, date])
}

/// One vehicle (and its own optional driver/guide) assigned to a Departure —
/// a Departure can have zero, one, or many of these, so a single departure
/// can run several vehicles in parallel (e.g. a jeeping tour split across
/// 4-5 jeeps), each independently crewed. `vehicleId` is nullable to
/// preserve the pre-existing "guide/driver, no vehicle" case (confirmed
/// still in live use — a walking-tour-style departure) — every row is
/// fundamentally a driver/guide (+ optional vehicle) assignment slot.
model DepartureVehicle {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departureId    String
  departure      Departure    @relation(fields: [departureId], references: [id], onDelete: Cascade)

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId  String?
  driver    User?    @relation("DepartureVehicleDriver", fields: [driverId], references: [id], onDelete: SetNull)
  guideId   String?
  guide     User?    @relation("DepartureVehicleGuide", fields: [guideId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([departureId, vehicleId])
  @@index([organizationId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([guideId])
}

/// A customer's reservation on a Departure.
model Booking {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departureId    String
  departure      Departure    @relation(fields: [departureId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  paxCount        Int
  totalPrice      Decimal       @db.Decimal(10, 2)
  discountPercent Int           @default(0)
  currency        String        @default("AMD")
  status          BookingStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  source          BookingSource @default(MANUAL)
  createdByUserId String?
  createdByUser   User?         @relation("BookingCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  specialRequests String?
  lookupToken     String        @unique @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments  Payment[]
  travelers BookingTraveler[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([departureId])
  @@index([organizationId, customerId])
}

/// A named member of a booking's party beyond the primary Customer (pax 2..N) —
/// lets staff record who else is travelling, mark children, and price them
/// individually (full/half/free) within the same booking.
model BookingTraveler {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingId      String
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  fullName  String
  isChild   Boolean           @default(false)
  priceType TravelerPriceType @default(FULL)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([bookingId])
}

/// A vehicle an agency can assign to departures.
model Vehicle {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  type         String?
  capacity     Int
  licensePlate String?
  driverName   String?
  driverPhone  String?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departureVehicles DepartureVehicle[]

  @@index([organizationId])
}

/// A payment (full or partial) recorded against a Booking.
model Payment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingId      String
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  amount            Decimal             @db.Decimal(10, 2)
  currency          String              @default("AMD")
  method            PaymentMethod       @default(CASH)
  status            PaymentRecordStatus @default(COMPLETED)
  externalReference String?
  recordedByUserId  String?
  paidAt            DateTime            @default(now())

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([bookingId])
}

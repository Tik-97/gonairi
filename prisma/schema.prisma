// Prisma schema for ToursOrganizer — multi-tenant tour agency SaaS + booking marketplace.
// See C:\Users\Tigran\.claude\plans\cuddly-inventing-stonebraker.md for the architecture this implements.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  OPERATOR
  DRIVER
  GUIDE
  /// Can be assigned to a departure's vehicle as either the driver or the
  /// guide (or both, on the same DepartureVehicle row) — for tours (e.g.
  /// jeeping tours) where one person routinely does both jobs.
  DRIVER_GUIDE
}

enum AttendanceStatus {
  WORKED
  ABSENT
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum DepartureStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum BookingSource {
  MANUAL
  ONLINE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD_ONLINE
  OTHER
}

enum PaymentRecordStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum TravelerPriceType {
  FULL
  HALF
  FREE
}

/// A platform-level operator account — not tied to any tenant Organization.
/// Logs in through the shared /login page and manages the whole platform.
model PlatformAdmin {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// A single permission grant for a UserRole, platform-wide (not tenant-scoped).
/// This is the editable source of truth behind lib/auth/permissions.ts — the
/// Super Admin dashboard at /admin/roles adds/removes rows here instead of a
/// permission matrix being hardcoded in application code.
model RolePermission {
  id         String   @id @default(cuid())
  role       UserRole
  permission String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([role, permission])
  @@index([role])
}

/// A tenant: one tour agency using the platform.
model Organization {
  id           String  @id @default(cuid())
  ownerId      String
  owner        User    @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  name         String
  slug         String  @unique
  description  String?
  logoUrl      String?
  contactEmail String?
  contactPhone String?
  address      String?
  language     String  @default("hy")
  currency     String  @default("AMD")
  timezone     String  @default("Asia/Yerevan")
  isPublished  Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  users             User[]             @relation("OrganizationMembers")
  customers         Customer[]
  tours             Tour[]
  departures        Departure[]
  departureVehicles DepartureVehicle[]
  vehicles          Vehicle[]
  bookings          Booking[]
  payments          Payment[]
  bookingTravelers  BookingTraveler[]
  attendanceRecords Attendance[]
  tourCustomers     TourCustomer[]

  @@index([ownerId])
}

/// Agency account — owner/operator, plus drivers and guides who can be
/// assigned to departures. Assigned roles govern both permissions and, for
/// DRIVER/GUIDE/DRIVER_GUIDE, eligibility to show up in departure vehicle
/// assignment pickers (DRIVER_GUIDE is eligible for both the driver and
/// guide slot on a DepartureVehicle row).
model User {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation("OrganizationMembers", fields: [organizationId], references: [id], onDelete: SetNull)

  email        String     @unique
  passwordHash String
  name         String
  phone        String?
  roles        UserRole[] @default([OPERATOR])
  status       UserStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  createdBookings         Booking[]          @relation("BookingCreatedByUser")
  guidedDepartureVehicles DepartureVehicle[] @relation("DepartureVehicleGuide")
  drivenDepartureVehicles DepartureVehicle[] @relation("DepartureVehicleDriver")
  attendanceRecords       Attendance[]
  ownedOrganizations      Organization[]     @relation("OrganizationOwner")

  @@index([organizationId])
  @@index([roles], type: Gin)
}

/// A day marked as worked or absent for a staff member — the basic HR/attendance ledger.
model Attendance {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  date   DateTime         @db.Date
  status AttendanceStatus
  note   String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([userId, date])
  @@index([organizationId, date])
}

/// CRM contact — independent of User; created manually by staff or from a guest booking.
model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  fullName    String
  email       String?
  phone       String?
  nationality String?
  notes       String?
  source      BookingSource @default(MANUAL)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  bookings      Booking[]
  tourCustomers TourCustomer[]

  @@index([organizationId])
  @@index([organizationId, email])
}

/// ISO 3166-1 country reference data shared by every tenant. Countries are
/// intentionally global: an agency selects destinations, but does not own or
/// rename the geographic catalogue.
model Country {
  id   String  @id @default(cuid())
  iso2 String  @unique @db.VarChar(2)
  iso3 String? @unique @db.VarChar(3)
  name String

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  regions Region[]

  @@index([isActive, sortOrder, name])
}

/// A geographic subdivision/locality from the versioned seed catalogue.
/// `isoCode` stores normalized ISO-style subdivision codes where the source
/// supplies one; it remains nullable instead of inventing codes for 179 source
/// records and for retained legacy/product-specific groupings.
model Region {
  id        String  @id @default(cuid())
  countryId String
  country   Country @relation(fields: [countryId], references: [id], onDelete: Restrict)

  isoCode String? @unique @db.VarChar(10)
  name    String
  type    String?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tourRegions TourRegion[]

  @@unique([countryId, name])
  @@index([countryId, isActive, sortOrder, name])
}

/// A shared, seeded tour-discovery hashtag. Categories are global reference
/// data rather than tenant-owned free text so filters remain consistent.
model Category {
  id    String @id @default(cuid())
  slug  String @unique @db.VarChar(50)
  label String

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tourCategories TourCategory[]

  @@index([isActive, sortOrder, label])
}

/// A tour product template (not itself bookable; Departures are). A deferred
/// database constraint requires at least one TourRegion at transaction commit.
model Tour {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title            String
  slug             String
  description      String?
  durationDays     Int      @default(1)
  languagesOffered String[]
  images           String[]
  itinerary        Json?
  included         String?
  excluded         String?
  basePrice        Decimal  @db.Decimal(10, 2)
  currency         String   @default("AMD")
  isPublished      Boolean  @default(false)
  /// Customer-specific tours remain fully operational in the back office but
  /// can never be exposed through the public marketplace.
  isPrivate        Boolean  @default(false)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  departures     Departure[]
  tourRegions    TourRegion[]
  tourCategories TourCategory[]
  tourCustomers  TourCustomer[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, isPublished])
  @@index([organizationId, deletedAt])
}

/// Explicit audience for a private/individual tour. Keeping this separate
/// from Booking lets an agency design the tour for customers before a dated
/// departure (and therefore a reservation) exists.
model TourCustomer {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  tourId String
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([tourId, customerId])
  @@index([organizationId, customerId])
}

/// Ordered many-to-many link between tours and geographic regions. Keeping an
/// explicit join model lets the product preserve itinerary/display order and
/// add destination-specific metadata later without changing the relationship.
model TourRegion {
  tourId String
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  regionId String
  region   Region @relation(fields: [regionId], references: [id], onDelete: Restrict)

  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([tourId, regionId])
  @@unique([tourId, position])
  @@index([regionId, tourId])
}

/// Ordered many-to-many link between a tour and its discovery hashtags.
model TourCategory {
  tourId String
  tour   Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([tourId, categoryId])
  @@unique([tourId, position])
  @@index([categoryId, tourId])
}

/// A scheduled, dated, bookable instance of a Tour.
model Departure {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tourId         String
  tour           Tour         @relation(fields: [tourId], references: [id], onDelete: Cascade)

  date          DateTime        @db.Timestamptz(3)
  /// Estimated return time — when the assigned vehicle is expected back and
  /// free to be booked on another departure. Null means unknown; conflict
  /// checks then assume the vehicle is tied up for a full 24h from `date`.
  returnAt      DateTime?       @db.Timestamptz(3)
  capacity      Int
  bookedCount   Int             @default(0)
  priceOverride Decimal?        @db.Decimal(10, 2)
  status        DepartureStatus @default(SCHEDULED)
  notes         String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  bookings Booking[]
  vehicles DepartureVehicle[]

  @@index([organizationId, tourId, date])
  @@index([organizationId, date])
}

/// One vehicle (and its own optional driver/guide) assigned to a Departure —
/// a Departure can have zero, one, or many of these, so a single departure
/// can run several vehicles in parallel (e.g. a jeeping tour split across
/// 4-5 jeeps), each independently crewed. `vehicleId` is nullable to
/// preserve the pre-existing "guide/driver, no vehicle" case (confirmed
/// still in live use — a walking-tour-style departure) — every row is
/// fundamentally a driver/guide (+ optional vehicle) assignment slot.
model DepartureVehicle {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departureId    String
  departure      Departure    @relation(fields: [departureId], references: [id], onDelete: Cascade)

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId  String?
  driver    User?    @relation("DepartureVehicleDriver", fields: [driverId], references: [id], onDelete: SetNull)
  guideId   String?
  guide     User?    @relation("DepartureVehicleGuide", fields: [guideId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([departureId, vehicleId])
  @@index([organizationId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([guideId])
}

/// A customer's reservation on a Departure.
model Booking {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departureId    String
  departure      Departure    @relation(fields: [departureId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  paxCount        Int
  totalPrice      Decimal       @db.Decimal(10, 2)
  discountPercent Int           @default(0)
  currency        String        @default("AMD")
  status          BookingStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  source          BookingSource @default(MANUAL)
  createdByUserId String?
  createdByUser   User?         @relation("BookingCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  specialRequests String?
  lookupToken     String        @unique @default(cuid())

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  payments  Payment[]
  travelers BookingTraveler[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([departureId])
  @@index([organizationId, customerId])
}

/// A named member of a booking's party beyond the primary Customer (pax 2..N) —
/// lets staff record who else is travelling, mark children, and price them
/// individually (full/half/free) within the same booking.
model BookingTraveler {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingId      String
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  fullName  String
  isChild   Boolean           @default(false)
  priceType TravelerPriceType @default(FULL)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([organizationId])
  @@index([bookingId])
}

/// A vehicle an agency can assign to departures.
model Vehicle {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  type         String?
  capacity     Int
  licensePlate String?
  driverName   String?
  driverPhone  String?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  departureVehicles DepartureVehicle[]

  @@index([organizationId])
}

/// A payment (full or partial) recorded against a Booking.
model Payment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingId      String
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  amount            Decimal             @db.Decimal(10, 2)
  currency          String              @default("AMD")
  method            PaymentMethod       @default(CASH)
  status            PaymentRecordStatus @default(COMPLETED)
  externalReference String?
  recordedByUserId  String?
  paidAt            DateTime            @default(now()) @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([organizationId])
  @@index([bookingId])
}
